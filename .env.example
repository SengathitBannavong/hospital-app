# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# Backend API base URL, no trailing slash.
# Falls back to http://localhost:3000 if unset (see lib/core/config/app_config.dart).
BASE_URL=http://localhost:3000

# Optional app-level API key sent by the Dio client.
# Leave blank if the backend does not require one.
API_KEY=

# Optional display name.
APP_NAME=Hospital App

# ── Firebase / push notifications ──────────────────────────────────────────
# NOT read from .env. Firebase is OPTIONAL and configured at build time via
# --dart-define (see FIREBASE.md). For reference:
#   flutter run \
#     --dart-define=ENABLE_FIREBASE=true \
#     --dart-define=FIREBASE_ANDROID_API_KEY=<android key> \
#     --dart-define=FIREBASE_IOS_API_KEY=<ios key> \
#     --dart-define=FIREBASE_WEB_API_KEY=<web key>
